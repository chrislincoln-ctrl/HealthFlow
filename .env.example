# Copy to .env and set your key. The key is read ONLY by server/index.mjs —
# it is never bundled into the client. Without a key, the app silently uses the
# deterministic local intelligence provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
PORT=8787

# ── Supabase Auth ────────────────────────────────────────────────────────
# Project URL + publishable (anon) key are PUBLIC by design — they are safe
# to bundle into the client; row-level security protects the data, not the key.
# NEVER add the service_role key to this file or any client module.
VITE_SUPABASE_URL=
# Either the classic anon key or the newer sb_publishable_... format works:
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
